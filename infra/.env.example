# Copie para infra/.env e preencha. O .env real nunca é versionado.

# ---------- Postgres ----------
POSTGRES_USER=integra
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=integra

# ---------- Aplicação ----------
INTEGRA_AMBIENTE=local

# Mínimo 32 caracteres; o serviço se recusa a subir com menos.
# Gere um por ambiente — nunca reaproveite o de desenvolvimento em produção:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTEGRA_JWT_SECRET=

# Segredo compartilhado entre auth-service e user-service para as rotas
# internas (criação de perfil no cadastro). Distinto do JWT: quem chama é um
# serviço, não um usuário. Mínimo 32 caracteres, gerado do mesmo jeito.
INTEGRA_SERVICO_TOKEN=

# ---------- Object Storage (Sprint 5) ----------
# Local é o MinIO do compose; em produção, o Object Storage da Oracle. A troca é
# só destas quatro linhas — a API é compatível com S3 e os serviços apenas
# ASSINAM a URL, sem nunca chamar o storage.

# O endpoint que o CLIENTE alcança, não o nome na rede interna. Assinar é
# computação local: quem precisa resolver este host é o celular, não o serviço.
# Com `http://minio:9000` aqui, a URL assinada só funcionaria dentro do compose.
INTEGRA_STORAGE_ENDPOINT=http://localhost:9000
INTEGRA_STORAGE_BUCKET=integra

# Credenciais do MinIO local. Em produção são as do par de chaves do Object
# Storage, e aí estas duas variáveis não se chamam MINIO_*: os serviços leem
# INTEGRA_STORAGE_ACCESS_KEY / _SECRET_KEY, que o compose preenche a partir daqui.
MINIO_ROOT_USER=integra
MINIO_ROOT_PASSWORD=troque-esta-senha-do-minio

# ---------- Só produção (docker-compose.prod.yml) ----------
# DOMINIO=api.integra.app
# ACME_EMAIL=voces@exemplo.com
