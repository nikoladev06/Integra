# Copie para infra/.env e preencha. O .env real nunca é versionado.

# ---------- Postgres ----------
POSTGRES_USER=integra
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=integra

# ---------- Aplicação ----------
INTEGRA_AMBIENTE=local

# Mínimo 32 caracteres; o serviço se recusa a subir com menos.
# Gere um por ambiente — nunca reaproveite o de desenvolvimento em produção:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTEGRA_JWT_SECRET=

# Segredo compartilhado entre auth-service e user-service para as rotas
# internas (criação de perfil no cadastro). Distinto do JWT: quem chama é um
# serviço, não um usuário. Mínimo 32 caracteres, gerado do mesmo jeito.
INTEGRA_SERVICO_TOKEN=

# ---------- Só produção (docker-compose.prod.yml) ----------
# DOMINIO=api.integra.app
# ACME_EMAIL=voces@exemplo.com
